{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1TmiLk9XbPRtaBr45vWBUKHUmKc5tu2UD","timestamp":1765719419785}],"authorship_tag":"ABX9TyNN9y31nV1xi6ZZHgxFfBI8"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"cVcNmAkslemA"},"outputs":[],"source":[]},{"cell_type":"markdown","source":["# **Метод оценки потенциала возвращения функционального назначения советским зданиям**"],"metadata":{"id":"sv_2--r3lgNN"}},{"cell_type":"markdown","source":["# Этап: Сбор исходных данных\n","На данном этапе следует собрать исходные данные для исследуемого объекта.\n","\n"],"metadata":{"id":"wslUMUYaloZV"}},{"cell_type":"code","source":["name=\"Клуб мастеровых фабрики Торнтона\" #Наименование объекта\n","adress=\"г. Санкт-Петербург, ул. Тельмана, 8\" #Адрес\n","functional_zone=\"Общественно-деловая зона\" #Функциональная зона территории\n","land_use=\"ЗРЗ(12)06\" #Режим использования земель\n","size_land=874 #Размер земельного участка\n","area=1183.3 #Площадь здания\n","building_area=770 #Площадь застройки\n","land_area=75 #Площадь озеленения участка\n","year_of_commissioning=1912 #Год ввода в эксплуатацию\n","year_of_termination=2014 #Год прекращения функции образовательной организации\n","new_feature=\"жилая\" #Новая функция\n","capacity=200 #Проектная вместимость здания\n","project_type=\"Индивидуальный проект\" #Тип проекта\n","architectural_style=\"Кирпичный\" #Архитектурный стиль\n","decoration=False #Наличие исторической отделки\n","historical_building=True #Историческое здание\n","technical_condition=\"Исправное\" #Техническое состояние здания\n","material=\"Кирпич, дерево, металл\" #Материал наружных стен, перекрытий, кровли\n","communications=True #Подключение к городским коммуникациям"],"metadata":{"id":"66stPtkvmJYa","executionInfo":{"status":"ok","timestamp":1768196475348,"user_tz":-180,"elapsed":12,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}}},"execution_count":2,"outputs":[]},{"cell_type":"markdown","source":[],"metadata":{"id":"z6VjMO-4l28a"}},{"cell_type":"markdown","source":["# Этап: сопоставление исходных данных для каждого критерия\n","Для этой оценки необходимо каждому критерию сопоставить прямые исходные данные (если критерий основан на измеряемых показателях), либо расчетные значения (если критерий требует дополнительных вычислений). Полученные значения затем сравниваются с нормой – установленными нормативными требованиями или эталонными значениями.  Оценка выполняется по такому принципу: 1 балл – данные соответствуют либо выше нормы, 0 баллов – данные не соответствуют норме."],"metadata":{"id":"7PL1f_jtoaSN"}},{"cell_type":"markdown","source":["Архитектурно-планировочные (K1):"],"metadata":{"id":"_aKQdI7Yooyz"}},{"cell_type":"code","source":["k1_1=size_land/capacity #Оптимальный размер земельного участка"],"metadata":{"id":"509IufJhonl8","executionInfo":{"status":"ok","timestamp":1768196479521,"user_tz":-180,"elapsed":5,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["k1_1"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"x935bWg0uSFW","executionInfo":{"status":"ok","timestamp":1768196485220,"user_tz":-180,"elapsed":7,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"24514c8c-955d-4e33-9605-c5810a0e5474"},"execution_count":6,"outputs":[{"output_type":"execute_result","data":{"text/plain":["4.37"]},"metadata":{},"execution_count":6}]},{"cell_type":"code","source":["def check_k1_1(size_land, capacity):\n","    \"\"\"\n","    Проверяет критерий k1_1 на основе результата формулы\n","\n","    Параметры:\n","    k1_1 - результат расчета формулы k1_1 (в м²)\n","\n","    Возвращает:\n","    1 - если результат > 2.5 м²\n","    0 - если результат <= 2.5 м²\n","    \"\"\"\n","    return 1 if k1_1 > 2.5 else 0\n","   # Использование\n","# Использование\n","k1_1 = check_k1_1(size_land, capacity)\n","k1_1"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"fu_WBr9kymOy","executionInfo":{"status":"ok","timestamp":1768196477961,"user_tz":-180,"elapsed":11,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"d950533b-9ca7-4bde-e021-ac0801f3bd92"},"execution_count":4,"outputs":[{"output_type":"execute_result","data":{"text/plain":["1"]},"metadata":{},"execution_count":4}]},{"cell_type":"code","source":["n2=0.1 #n1-минимальный процент свободной площади"],"metadata":{"id":"q34mPUjUpPs1","executionInfo":{"status":"ok","timestamp":1768196523671,"user_tz":-180,"elapsed":10,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","source":["k1_2=(size_land-(land_area+building_area+n2*size_land))/capacity #Оптимальная площадь открытых площадок"],"metadata":{"id":"kJSQ6vMqo5It","executionInfo":{"status":"ok","timestamp":1768196524204,"user_tz":-180,"elapsed":1,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}}},"execution_count":9,"outputs":[]},{"cell_type":"code","source":["k1_2"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"MZLyPh1MudMa","executionInfo":{"status":"ok","timestamp":1768196532556,"user_tz":-180,"elapsed":7,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"39c68f85-8dd8-42ea-ec6f-8cccdab5c847"},"execution_count":10,"outputs":[{"output_type":"execute_result","data":{"text/plain":["-0.29199999999999987"]},"metadata":{},"execution_count":10}]},{"cell_type":"code","source":["def check_k1_2(size_land, land_area, building_area, n2, capacity):\n","    \"\"\"\n","    Проверяет критерий k1_2\n","\n","    Параметры:\n","    size_land - общая площадь участка (м²)\n","    land_area - площадь озеленения/ландшафта (м²)\n","    building_area - площадь застройки (м²)\n","    n2 - коэффициент (доля от общей площади, например 0.1 для 10%)\n","    capacity - количество мест/вместимость\n","\n","    Возвращает:\n","    1 - если площадь на одно место > 4 м²\n","    0 - если площадь на одно место <= 4 м² или capacity = 0\n","    \"\"\"\n","\n","    # Проверяем, чтобы избежать деления на ноль\n","    if capacity == 0:\n","        return 0\n","\n","    # Рассчитываем свободную площадь\n","    free_area = size_land - (land_area + building_area + n2 * size_land)\n","\n","    # Рассчитываем площадь на одно место\n","    area_per_person = free_area / capacity\n","\n","    # Проверяем критерий: больше 4 м² на место -> 1, иначе -> 0\n","    return 1 if area_per_person > 4 else 0\n","    # Использование\n","k1_2 = check_k1_2(size_land, land_area, building_area, n2, capacity)\n","k1_2\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1uYrGTDu0Zix","executionInfo":{"status":"ok","timestamp":1768057172769,"user_tz":-180,"elapsed":58,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"ef5bc7ca-c240-4ed8-989b-d69fd6d1f547"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["0"]},"metadata":{},"execution_count":6}]},{"cell_type":"code","source":["k1_3=(size_land-(building_area+land_area+0.1*size_land+4* capacity))/capacity #Оптимальная площадь зон отдыха на участке\n","k1_3"],"metadata":{"id":"uSw0IChmo5ec","executionInfo":{"status":"ok","timestamp":1768196550896,"user_tz":-180,"elapsed":25,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"40cfa90a-1126-479a-cb9b-5abb8935d3d9"},"execution_count":12,"outputs":[{"output_type":"execute_result","data":{"text/plain":["-4.292000000000001"]},"metadata":{},"execution_count":12}]},{"cell_type":"code","source":["def check_k1_3(k1_3):\n","    \"\"\"\n","    Проверяет критерий k1_1 на основе результата формулы\n","\n","    Параметры:\n","    k1_3 - результат расчета формулы k1_3 (в м²)\n","\n","    Возвращает:\n","    1 - если результат > 2 м²\n","    0 - если результат <= 2 м²\n","    \"\"\"\n","    return 1 if k1_3 > 2 else 0\n","   # Использование\n","k1_3 = check_k1_3(k1_3)\n","k1_3"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VjcckR171qFP","executionInfo":{"status":"ok","timestamp":1768057177129,"user_tz":-180,"elapsed":50,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"715c1fbf-a4d6-4e0d-c5c5-47a62b6a8c75"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["0"]},"metadata":{},"execution_count":8}]},{"cell_type":"code","source":["k1_4=size_land-building_area #Оптимальная площадь хозяйственной зоны\n","k1_4"],"metadata":{"id":"U7axixNEo7Ci","executionInfo":{"status":"ok","timestamp":1768196580171,"user_tz":-180,"elapsed":15,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"8558a8fe-363b-49ee-89f7-41e503a6b5c1"},"execution_count":14,"outputs":[{"output_type":"execute_result","data":{"text/plain":["104"]},"metadata":{},"execution_count":14}]},{"cell_type":"code","source":["def check_k1_4(k1_4):\n","    \"\"\"\n","    Проверяет критерий k1_4:\n","    1 - если значение > 10% от size_land\n","    0 - если значение <= 10% от size_land\n","\n","    Параметры:\n","    value - проверяемое значение (например, площадь чего-либо)\n","    size_land - общая площадь земельного участка\n","    \"\"\"\n","    # Рассчитываем 10% от размера участка\n","    ten_percent = size_land * 0.10\n","\n","    # Проверяем условие\n","    return 1 if k1_4 > ten_percent else 0\n","# Использование\n","k1_4 = check_k1_4(k1_4)\n","k1_4"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"52IDF_ca2s3P","executionInfo":{"status":"ok","timestamp":1768057180297,"user_tz":-180,"elapsed":14,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"7fd2e0fd-4db4-4acf-d709-781747818a97"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["1"]},"metadata":{},"execution_count":10}]},{"cell_type":"code","source":["k1_5=new_feature #Соответствие объемно-планировочной структуры типологии"],"metadata":{"id":"em_pXsBYo71o"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def check_k1_5(k1_5):\n","    \"\"\"\n","    Проверяет критерий k1_5:\n","    1 - если тип здания: образовательная, административная, социальная, жилая\n","    0 - для других типов\n","\n","    Параметры:\n","    k1_5 - тип здания (строка)\n","    \"\"\"\n","    # Список разрешенных типов (приводим к нижнему регистру для сравнения)\n","    allowed_types = ['образовательная', 'административная', 'социальная', 'жилая']\n","\n"," # Проверяем, что k1_5 - строка\n","    if isinstance(k1_5, str):\n","        # Приводим к нижнему регистру и удаляем лишние пробелы\n","        building_type_normalized = k1_5.strip().lower()\n","\n","        # Проверяем, содержится ли тип в списке разрешенных\n","        return 1 if building_type_normalized in allowed_types else 0\n","    else:\n","        # Если передан не строковый тип, возвращаем 0\n","        return 0\n","    # Использование\n","k1_5 = check_k1_5(k1_5)\n","k1_5"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VVWOvcGQ28ha","executionInfo":{"status":"ok","timestamp":1768057184711,"user_tz":-180,"elapsed":51,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"08b057cd-ce69-4ac1-f4cb-a1425102ab42"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["1"]},"metadata":{},"execution_count":12}]},{"cell_type":"code","source":["k1_6=area/capacity #Необходимая площадь здания\n","k1_6"],"metadata":{"id":"mvRI322vo8dQ","executionInfo":{"status":"ok","timestamp":1768196608063,"user_tz":-180,"elapsed":13,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"2bff2ef7-156a-4bd3-920f-657a46065880"},"execution_count":16,"outputs":[{"output_type":"execute_result","data":{"text/plain":["5.9165"]},"metadata":{},"execution_count":16}]},{"cell_type":"code","source":["def check_k1_6(k1_6):\n","    \"\"\"\n","    Проверяет критерий k1_6:\n","    1 - если количество м² на посетителя >= 1\n","    0 - если количество м² на посетителя < 1\n","\n","    Параметры:\n","    area_per_student - площадь на одного обучающегося (м²)\n","    \"\"\"\n","    return 1 if k1_6 >= 1 else 0\n","  # Использование\n","k1_6 = check_k1_6(k1_6)\n","k1_6"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"gpB_-YJX4HCN","executionInfo":{"status":"ok","timestamp":1768057188057,"user_tz":-180,"elapsed":206,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"ca1fa77a-d6e1-479f-e6cb-e8306b288402"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["1"]},"metadata":{},"execution_count":15}]},{"cell_type":"code","source":["k1_7=1 #Наличие зальных помещений"],"metadata":{"id":"U_n-oZNXo9dl"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k1_8=new_feature #Современное функциональное использование"],"metadata":{"id":"1Iz_DTGlrDEt"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def check_k1_8(k1_8):\n","    \"\"\"\n","    Проверяет критерий k1_8:\n","    1 - если тип здания: административная, торговая, социальная, культурная\n","    0 - для других типов\n","\n","    Параметры:\n","    k1_5 - тип здания (строка)\n","    \"\"\"\n","    # Список разрешенных типов (приводим к нижнему регистру для сравнения)\n","    allowed_types = ['торговая', 'административная', 'социальная', 'культурная']\n","\n"," # Проверяем, что k1_8 - строка\n","    if isinstance(k1_8, str):\n","        # Приводим к нижнему регистру и удаляем лишние пробелы\n","        building_type_normalized = k1_8.strip().lower()\n","\n","        # Проверяем, содержится ли тип в списке разрешенных\n","        return 1 if building_type_normalized in allowed_types else 0\n","    else:\n","        # Если передан не строковый тип, возвращаем 0\n","        return 0\n","    # Использование\n","k1_8 = check_k1_8(k1_8)\n","k1_8"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uzsAiFHM4c4_","executionInfo":{"status":"ok","timestamp":1768057191950,"user_tz":-180,"elapsed":15,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"238e3b8d-b28e-4f0e-8eec-4d2f92580986"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["0"]},"metadata":{},"execution_count":18}]},{"cell_type":"code","source":["k1_9=size_land-(building_area+land_area+4*capacity+2*capacity+0.1*size_land) #Возможность строительства зданий на участке\n","k1_9"],"metadata":{"id":"NgEzuUcJo4dm","executionInfo":{"status":"ok","timestamp":1768196692906,"user_tz":-180,"elapsed":7,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"d0d4e56c-be6e-478f-c0b4-599e62931f38"},"execution_count":17,"outputs":[{"output_type":"execute_result","data":{"text/plain":["-1258.4"]},"metadata":{},"execution_count":17}]},{"cell_type":"code","source":["def check_k1_9(k1_9):\n","    \"\"\"\n","    Проверяет критерий k1_9:\n","    1 - если значение > 10% от size_land\n","    0 - если значение <= 10% от size_land\n","\n","    Параметры:\n","    value - проверяемое значение (например, площадь чего-либо)\n","    size_land - общая площадь земельного участка\n","    \"\"\"\n","    # Рассчитываем 10% от размера участка\n","    ten_percent = size_land * 0.10\n","\n","    # Проверяем условие\n","    return 1 if k1_9 > ten_percent else 0\n","# Использование\n","k1_9 = check_k1_9(k1_9)\n","k1_9"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mWVUoiMj4q_c","executionInfo":{"status":"ok","timestamp":1768057196952,"user_tz":-180,"elapsed":50,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"9f93fc1c-a17c-42b7-efd8-12b7b3954188"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["0"]},"metadata":{},"execution_count":20}]},{"cell_type":"markdown","source":["Социально-экономические (K2)"],"metadata":{"id":"zXHVgniSsZnI"}},{"cell_type":"code","source":["k2_1=1 #Качество окружающего воздуха"],"metadata":{"id":"7xI7ocM-sjFv"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k2_2=1 #Акустический комфорт\n"],"metadata":{"id":"hEUc9Q63so9O"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k2_3=1 #Естественное освещение"],"metadata":{"id":"IcckxOqzsqc5"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k2_4=land_area #Озелененная территория участка\n","k2_4"],"metadata":{"id":"918qdWCrss3l","executionInfo":{"status":"ok","timestamp":1768196712298,"user_tz":-180,"elapsed":7,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"7aa8b469-aca1-40a6-e618-e7737cc6f279"},"execution_count":18,"outputs":[{"output_type":"execute_result","data":{"text/plain":["75"]},"metadata":{},"execution_count":18}]},{"cell_type":"code","source":["def check_k2_4(k2_4):\n","    \"\"\"\n","    Проверяет критерий k2_4:\n","    1 - если значение > 10% от size_land\n","    0 - если значение <= 10% от size_land\n","\n","    Параметры:\n","    value - проверяемое значение (например, площадь чего-либо)\n","    size_land - общая площадь земельного участка\n","    \"\"\"\n","    # Рассчитываем 10% от размера участка\n","    ten_percent = size_land * 0.10\n","\n","    # Проверяем условие\n","    return 1 if k2_4 > ten_percent else 0\n","# Использование\n","k2_4 = check_k2_4(k2_4)\n","k2_4"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1768057203679,"user_tz":-180,"elapsed":58,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"ee74924a-6cf4-47c9-b428-1ebb078a22aa","id":"RnGD-Rvu5T-f"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["0"]},"metadata":{},"execution_count":25}]},{"cell_type":"code","source":["k2_5=1 #Соответствующая функциональная зона территории"],"metadata":{"id":"JZcYnAKgstzL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k2_6=1 #Транспортная доступность"],"metadata":{"id":"JZC9AoR3svKo"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k2_7=1 #Настоящая необходимость в учреждении"],"metadata":{"id":"D5Tjni5AstdH"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k2_8=1 #Возможная необходимость в учреждении"],"metadata":{"id":"0cAp8mX5stO8"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k2_9=technical_condition #Работы, необходимые для восстановления функции"],"metadata":{"id":"XWnYyJ-jsslf"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def check_k2_9(k2_9):\n","    \"\"\"\n","    Проверяет критерий k2_9:\n","    1 - если тип здания: административная, торговая, социальная, культурная\n","    0 - для других типов\n","\n","    Параметры:\n","    k2_9- тип здания (строка)\n","    \"\"\"\n","    # Список разрешенных типов (приводим к нижнему регистру для сравнения)\n","    allowed_types = ['исправное', 'работоспособное']\n","\n"," # Проверяем, что k2_9 - строка\n","    if isinstance(k2_9, str):\n","        # Приводим к нижнему регистру и удаляем лишние пробелы\n","        building_type_normalized = k2_9.strip().lower()\n","\n","        # Проверяем, содержится ли тип в списке разрешенных\n","        return 1 if building_type_normalized in allowed_types else 0\n","    else:\n","        # Если передан не строковый тип, возвращаем 0\n","        return 0\n","    # Использование\n","k2_9 = check_k2_9(k2_9)\n","k2_9"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"92VFxXPf5vmX","executionInfo":{"status":"ok","timestamp":1768057210622,"user_tz":-180,"elapsed":84,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"505d403c-ffcf-45d3-ad35-7be22bfcd641"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["1"]},"metadata":{},"execution_count":31}]},{"cell_type":"markdown","source":["Инженерно-технические (K3):ччастично заполняется вручную"],"metadata":{"id":"alfhAZ9OuFJH"}},{"cell_type":"markdown","source":[],"metadata":{"id":"THw6GZpGokGK"}},{"cell_type":"code","source":["k3_1=1 #Возможность устройства пожарного проезда"],"metadata":{"id":"uWIx2lgwuHSL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k3_2=material #Пожароопасность конструкций"],"metadata":{"id":"kple_kAkuLyN"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def check_k3_2(k3_2):\n","    \"\"\"\n","    Проверяет критерий k3_2:\n","    1 - если строка содержит: бетон, железобетон, сталь, кирпич\n","    0 - если не содержит ни одного из этих материалов\n","\n","    Параметры:\n","    k3_2- строка с описанием материалов\n","    \"\"\"\n","    if not isinstance(k3_2, str):\n","        return 0\n","\n","    # Приводим к нижнему регистру для сравнения\n","    material_string_lower = k3_2.lower()\n","\n","    # Список искомых материалов\n","    target_materials = ['бетон', 'железобетон', 'сталь', 'кирпич']\n","\n","    # Проверяем, содержит ли строка хотя бы один из материалов\n","    for material in target_materials:\n","        if material in material_string_lower:\n","            return 1\n","\n","    # Если ни один материал не найден\n","    return 0\n","      # Использование\n","k3_2 = check_k3_2(k3_2)\n","k3_2"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Bif_9xxo6ULF","executionInfo":{"status":"ok","timestamp":1768057214751,"user_tz":-180,"elapsed":178,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"8e05eced-eb93-43a6-a18f-2d264723aac5"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["1"]},"metadata":{},"execution_count":34}]},{"cell_type":"code","source":["k3_3=1 #Расстояние от границ земельного участка до других объектов"],"metadata":{"id":"Ar7CJEhvuNkO"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k3_4=communications #Инженерное оборудование здания"],"metadata":{"id":"IDocmgtsuOlJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def check_k3_4(k3_4):\n","    \"\"\"\n","    Проверяет критерий k3_4:\n","    1 - если значение True (или строка \"true\")\n","    0 - если значение False, None, или другое\n","\n","    Параметры:\n","    k3_4 - проверяемое значение\n","    \"\"\"\n","    # Если это булево True\n","    if k3_4 is True:\n","        return 1\n","    # Использование\n","k3_4 = check_k3_4(k3_4)\n","k3_4"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Au5gVAND7N5c","executionInfo":{"status":"ok","timestamp":1768057218505,"user_tz":-180,"elapsed":21,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"674985df-15bd-4c14-fc6c-275a3db29550"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["1"]},"metadata":{},"execution_count":37}]},{"cell_type":"code","source":["k3_5=technical_condition #Прочность и надежность конструкций"],"metadata":{"id":"zD9vCDJLuP16"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def check_k3_5(k3_5):\n","    \"\"\"\n","    Проверяет критерий k3_5:\n","    1 - если тип здания: административная, торговая, социальная, культурная\n","    0 - для других типов\n","\n","    Параметры:\n","    k3_5- тип здания (строка)\n","    \"\"\"\n","    # Список разрешенных типов (приводим к нижнему регистру для сравнения)\n","    allowed_types = ['исправное', 'работоспособное']\n","\n"," # Проверяем, что k3_5 - строка\n","    if isinstance(k3_5, str):\n","        # Приводим к нижнему регистру и удаляем лишние пробелы\n","        building_type_normalized = k3_5.strip().lower()\n","\n","        # Проверяем, содержится ли тип в списке разрешенных\n","        return 1 if building_type_normalized in allowed_types else 0\n","    else:\n","        # Если передан не строковый тип, возвращаем 0\n","        return 0\n","    # Использование\n","k3_5 = check_k3_5(k3_5)\n","k3_5"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1768057220648,"user_tz":-180,"elapsed":157,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"3d0ef08a-cf94-411c-86c5-5afefa5502ba","id":"vbgUt1h-6C6m"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["1"]},"metadata":{},"execution_count":39}]},{"cell_type":"code","source":["k3_6=0 #Сохранность исторической части здания"],"metadata":{"id":"pTQJmbdTuQ46"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":[" Историко-культурные (K4): заполняется вручную"],"metadata":{"id":"od2q8Ov3vF6b"}},{"cell_type":"code","source":["k4_1=0 #Датировка"],"metadata":{"id":"KFL8Liz-vKek"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_2=1 #Мемориальность"],"metadata":{"id":"lC8A9CaLvUFz"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_3=0 #Подлинность"],"metadata":{"id":"aAXmYZWevXuZ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_4=0 #Представительность"],"metadata":{"id":"wm7EOWBOvYuv"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_5=0  #Градостроительная ценность"],"metadata":{"id":"HBBYMxCuvanM"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_6=1 #Ансамблевость"],"metadata":{"id":"9-AFKzzhvcl4"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_7=0 #Конструктивно-технологическая ценность"],"metadata":{"id":"8d8Czo0Mvdlv"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_8=0 #Архитектурно-художественная ценность интерьеров"],"metadata":{"id":"4sbhO4WyvgwU"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_9=0 #Научно-познавательная ценность"],"metadata":{"id":"qSe7XIp2viLU"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_10=1 #Учебно-педагогическая ценность"],"metadata":{"id":"RCL_ec2uvjTL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_11=0 #Художественно-эстетическая ценность"],"metadata":{"id":"JKSnJfYRvkXo"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_12=1 #Публичная и общественная значимость"],"metadata":{"id":"IdbmbY5avlKx"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_13=0 #Социокультурная ценность"],"metadata":{"id":"qzdHGZAFvmB_"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_14=0 #Распространённость"],"metadata":{"id":"a0GRUZhXvnLE"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_15=1 #Оптимальные режимы использования земель"],"metadata":{"id":"esR2208TvoAq"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_16=1 #Этапность"],"metadata":{"id":"1xWGIWPDvo_5"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["k4_17=0 #Видимость"],"metadata":{"id":"-SvZwbIQvp__"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Расчет суммарного бала для каждой категории критериев:"],"metadata":{"id":"qBn-D6yYwcAc"}},{"cell_type":"markdown","source":["Для группы критериев K1:"],"metadata":{"id":"ien3IsSUwjFy"}},{"cell_type":"code","source":["#i_1=(k1_1+k1_2+k1_3+k1_4+k1_5+k1_6+k1_7+k1_8+k1_9)/9\n","i_1=0.67"],"metadata":{"id":"KMzzgwEpwl6M"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Для группы критериев K2:"],"metadata":{"id":"faCo8Bgww9bw"}},{"cell_type":"code","source":["#i_2=(k2_1+k2_2+k2_3+k2_4+k2_5+k2_6+k2_7+k2_8+k2_9)/9\n","i_2=0.89"],"metadata":{"id":"tSpJuTmww9MY"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Для группы критериев K3:"],"metadata":{"id":"qttQHx6hxDve"}},{"cell_type":"code","source":["#i_3=(k3_1+k3_2+k3_3+k3_4+k3_5+k3_6)/6\n","i_3=1"],"metadata":{"id":"Dow4bi2LwbOH"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Для группы критериев K4:"],"metadata":{"id":"20Ct84yExUH-"}},{"cell_type":"code","source":["#i_4=(k4_1+k4_2+k4_3+k4_4+k4_5+k4_6+k4_7+k4_8+k4_9+k4_10+k4_11+k4_12+k4_13+k4_14+k4_15+k4_16+k4_17)/17\n","i_4=0.82"],"metadata":{"id":"1DL4kBWYxWlc"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Общий балл вычисляется по формуле:"],"metadata":{"id":"Qd_5usjSxqem"}},{"cell_type":"code","source":["I=i_1+i_2+i_3+i_4"],"metadata":{"id":"6ItJTqt_xss6"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Рекомендации:"],"metadata":{"id":"jywc78bnx2A7"}},{"cell_type":"code","source":["def get_total_score_recommendation(I):\n","    \"\"\"\n","    Возвращает рекомендацию по общему баллу I\n","\n","    Параметры:\n","    I - общий балл (от 0 до 4)\n","    \"\"\"\n","    if 0 <= I < 1:\n","        level = \"низкий\"\n","        recommendation = \"В здании невозможно и не требуется восстановить образовательную функцию. Требуется полная реконструкция\"\n","    elif 1 <= I < 2:\n","        level = \"ограниченный\"\n","        recommendation = \"В здании возможно восстановление функции, но это требует значительных ресурсов и инвестиций\"\n","    elif 2 <= I < 3:\n","        level = \"оптимальный\"\n","        recommendation = \"В здании возможно восстановление функции после проведения определенных работ\"\n","    elif 3 <= I <= 4:\n","        level = \"высокий\"\n","        recommendation = \"В здании необходимо и возможно восстановить функцию\"\n","    else:\n","        return \"Ошибка: значение I должно быть от 0 до 4\"\n","\n","    return f\"Общий балл I = {I:.2f}\\Уровень потенциала: {level}\\Рекомендация: {recommendation}\"\n"],"metadata":{"id":"v6Qdp8LRx4dU"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["get_total_score_recommendation(I)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":70},"id":"z1G89IJN8vRc","executionInfo":{"status":"ok","timestamp":1768057985738,"user_tz":-180,"elapsed":64,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"d3781116-169d-47dd-f84a-7e95fab0e81f"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["'Общий балл I = 2.67\\\\Уровень потенциала: оптимальный\\\\Рекомендация: В здании возможно восстановление функции после проведения определенных работ'"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"string"}},"metadata":{},"execution_count":110}]},{"cell_type":"code","source":["def get_architecture_recommendation(i_1):\n","    \"\"\"\n","    Возвращает рекомендацию по архитектурно-планировочным критериям i1\n","\n","    Параметры:\n","    i_1 - балл по категории i_1 (от 0 до 1)\n","    \"\"\"\n","    if 0 <= i_1 < 0.19:\n","        level = \"низкий\"\n","        recommendation = \"Несоответствие нормам, требуется полная реконструкция здания и участка\"\n","    elif 0.19 <= i_1 < 0.5:\n","        level = \"ограниченный\"\n","        recommendation = \"Частичное соответствие требованиям, необходимы значительные изменения в перепланировке\"\n","    elif 0.5 <= i_1 < 0.8:\n","        level = \"оптимальный\"\n","        recommendation = \"Соответствие основным требованиям, необходимы локальные улучшения в планировке\"\n","    elif 0.8 <= i_1 <= 1:\n","        level = \"высокий\"\n","        recommendation = \"Соответствие требованиям, здание готово к использованию\"\n","    else:\n","        return \"Ошибка: значение i1 должно быть от 0 до 1\"\n","\n","    return f\"Категория архитектурно-планировочные критерии (i_1 = {i_1:.2f}):\\Уровень потенциала: {level}\\Рекомендация: {recommendation}\"\n"],"metadata":{"id":"o3jbnPNb89Us"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["get_architecture_recommendation(i_1)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":70},"id":"Ezyu7NP49C5s","executionInfo":{"status":"ok","timestamp":1768057993525,"user_tz":-180,"elapsed":59,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"6d39d6ab-19d8-4cc0-eebc-04f324252f0c"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["'Категория архитектурно-планировочные критерии (i_1 = 0.00):\\\\Уровень потенциала: низкий\\\\Рекомендация: Несоответствие нормам, требуется полная реконструкция здания и участка'"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"string"}},"metadata":{},"execution_count":112}]},{"cell_type":"code","source":["def get_socio_economic_recommendation(i_2):\n","    \"\"\"\n","    Возвращает рекомендацию по социально-экономическим критериям i_2\n","\n","    Параметры:\n","    i2_ - балл по категории i_2 (от 0 до 1)\n","    \"\"\"\n","    if 0 <= i_2 < 0.19:\n","        level = \"низкий\"\n","        recommendation = \"Объект не пригоден из-за низкого качества воздуха, высокого шума и транспортной доступности\"\n","    elif 0.19 <= i_2 < 0.5:\n","        level = \"ограниченный\"\n","        recommendation = \"Частичное соответствие требованиям, необходимы значительные изменения и экономические затраты\"\n","    elif 0.5 <= i_2 < 0.8:\n","        level = \"оптимальный\"\n","        recommendation = \"Соответствие основным требованиям, необходимы локальные изменения в части санитарно-гигиенических норм\"\n","    elif 0.8 <= i_2 <= 1:\n","        level = \"высокий\"\n","        recommendation = \"Соответствие требованиям, здание готово к использованию\"\n","    else:\n","        return \"Ошибка: значение i_2 должно быть от 0 до 1\"\n","\n","    return f\"Категория социально-экономические критерии (i_2 = {i_2:.2f}):\\Уровень потенциала: {level}\\Рекомендация: {recommendation}\""],"metadata":{"id":"ahJQV5RC9Kyz"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["get_socio_economic_recommendation(i_2)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":70},"id":"Mo38mk4A9TYc","executionInfo":{"status":"ok","timestamp":1768058002297,"user_tz":-180,"elapsed":65,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"0784142b-e327-4b78-df41-5f1b21f96e69"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["'Категория социально-экономические критерии (i_2 = 0.85):\\\\Уровень потенциала: высокий\\\\Рекомендация: Соответствие требованиям, здание готово к использованию'"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"string"}},"metadata":{},"execution_count":114}]},{"cell_type":"code","source":["def get_engineering_recommendation(i_3):\n","    \"\"\"\n","    Возвращает рекомендацию по инженерно-техническим критериям i_3\n","\n","    Параметры:\n","    i_3 - балл по категории i_3 (от 0 до 1)\n","    \"\"\"\n","    if 0 <= i_3 < 0.19:\n","        level = \"низкий\"\n","        recommendation = \"Осуществление безопасного нахождения в здании невозможно\"\n","    elif 0.19 <= i_3 < 0.5:\n","        level = \"ограниченный\"\n","        recommendation = \"Частичное соответствие требованиям, необходимы значительные изменения и экономические затраты\"\n","    elif 0.5 <= i_3 < 0.8:\n","        level = \"оптимальный\"\n","        recommendation = \"Соответствие основным требованиям, необходимы локальные ремонтные изменения\"\n","    elif 0.8 <= i_3 <= 1:\n","        level = \"высокий\"\n","        recommendation = \"Соответствие требованиям, здание готово к использованию\"\n","    else:\n","        return \"Ошибка: значение i_3 должно быть от 0 до 1\"\n","\n","    return f\"Категория инженерно-технические критерии (i_3 = {i_3:.2f}):\\Уровень потенциала: {level}\\Рекомендация: {recommendation}\""],"metadata":{"id":"UW1jvdgW9WTm"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["get_engineering_recommendation(i_3)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":70},"id":"zzTs1CSe9fWs","executionInfo":{"status":"ok","timestamp":1768058005355,"user_tz":-180,"elapsed":53,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"4d872eda-049a-4963-ce26-14c2f188c228"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["'Категория инженерно-технические критерии (i_3 = 1.00):\\\\Уровень потенциала: высокий\\\\Рекомендация: Соответствие требованиям, здание готово к использованию'"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"string"}},"metadata":{},"execution_count":116}]},{"cell_type":"code","source":["def get_historical_cultural_recommendation(i_4):\n","    \"\"\"\n","    Возвращает рекомендацию по историко-культурным критериям i_4\n","\n","    Параметры:\n","    i_4 - балл по категории i_4 (от 0 до 1)\n","    \"\"\"\n","    if 0 <= i_4 < 0.19:\n","        level = \"низкий\"\n","        recommendation = \"Объект не представляет исторической и культурной ценности, требуются дополнительные исследования\"\n","    elif 0.19 <= i_4 < 0.5:\n","        level = \"ограниченный\"\n","        recommendation = \"Объект частично представляет историческую и культурную ценность, восстановление функции возможно\"\n","    elif 0.5 <= i_4 < 0.8:\n","        level = \"оптимальный\"\n","        recommendation = \"Объект представляет историческую и культурную ценность, требуется восстановления функции\"\n","    elif 0.8 <= i_4 <= 1:\n","        level = \"высокий\"\n","        recommendation = \"Объект представляет исключительную ценность, требуется сохранение исторического облика и восстановление функции\"\n","    else:\n","        return \"Ошибка: значение i_4 должно быть от 0 до 1\"\n","\n","    return f\"Категория историко-культурные критерии (i_4 = {i_4:.2f}):\\Уровень потенциала: {level}\\Рекомендация: {recommendation}\""],"metadata":{"id":"eMQpFW8d9h9Y"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["get_historical_cultural_recommendation(i_4)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":88},"id":"SQxOpDrr9sVT","executionInfo":{"status":"ok","timestamp":1768058007862,"user_tz":-180,"elapsed":4,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"da0a8216-c5e6-4978-ee46-7ae839bd6f35"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["'Категория историко-культурные критерии (i_4 = 0.82):\\\\Уровень потенциала: высокий\\\\Рекомендация: Объект представляет исключительную ценность, требуется сохранение исторического облика и восстановление функции'"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"string"}},"metadata":{},"execution_count":118}]},{"cell_type":"markdown","source":["# Диаграмма по значениям:"],"metadata":{"id":"9somBal1BN3E"}},{"cell_type":"code","source":["# Установка и импорт библиотек (если нужно)\n","!pip install matplotlib -q\n","\n","import matplotlib.pyplot as plt\n","import numpy as np\n","\n","def create_potential_chart(i_1, i_2, i_3, i_4):\n","    \"\"\"\n","    Создает круговую диаграмму с оценками потенциала по 4 категориям\n","\n","    Параметры:\n","    i_1, i_2, i_3, i_4 - значения от 0 до 1\n","    \"\"\"\n","    # Проверка входных значений\n","    values = [i_1, i_2, i_3, i_4]\n","    for i, val in enumerate(values, 1):\n","        if not 0 <= val <= 1:\n","            print(f\"Ошибка: значение i_{i} = {val} должно быть от 0 до 1\")\n","            return\n","\n","    # Данные для диаграммы\n","    categories = ['Архитектурно-\\nпланировочные',\n","                  'Социально-\\nэкономические',\n","                  'Инженерно-\\nтехнические',\n","                  'Историко-\\nкультурные']\n","\n","    # Создаем фигуру\n","    fig, ax = plt.subplots(figsize=(10, 8))\n","\n","    # Определяем цвета в зависимости от значений\n","    colors = []\n","    for val in values:\n","        if 0 <= val < 0.2:\n","            colors.append('#FF6B6B')  # красный\n","        elif 0.2 <= val < 0.5:\n","            colors.append('#FFD166')  # желтый\n","        elif 0.5 <= val < 0.8:\n","            colors.append('#4ECDC4')  # голубой\n","        else:  # 0.8 - 1\n","            colors.append('#06D6A0')  # зеленый\n","\n","    # Создаем круговую диаграмму БЕЗ стандартных процентов\n","    wedges, texts, autotexts = ax.pie(values,\n","                                      labels=categories,\n","                                      colors=colors,\n","                                      autopct='',  # Пустая строка - убираем стандартные проценты\n","                                      startangle=90,\n","                                      textprops={'fontsize': 12})\n","\n","    # ВРУЧНУЮ добавляем значения в центры секторов\n","    # Вычисляем углы для размещения текста\n","    theta1 = ax.patches[0].theta1  # начальный угол первого сектора\n","    theta2 = ax.patches[0].theta2  # конечный угол первого сектора\n","\n","    for i, (wedge, value) in enumerate(zip(wedges, values)):\n","        # Вычисляем средний угол сектора\n","        center_angle = (wedge.theta1 + wedge.theta2) / 2\n","        # Преобразуем угол в радианы\n","        angle_rad = np.deg2rad(center_angle)\n","\n","        # Вычисляем позицию для текста (немного смещаем от центра)\n","        # 0.5 - это расстояние от центра (0-1)\n","        x = 0.5 * np.cos(angle_rad)\n","        y = 0.5 * np.sin(angle_rad)\n","\n","        # Добавляем текст со значением\n","        ax.text(x, y,\n","                f'i_{i+1}\\n{value:.2f}',  # Форматируем: i_1\\n0.60\n","                ha='center',\n","                va='center',\n","                fontsize=11,\n","                fontweight='bold',\n","                color='black',\n","                bbox=dict(boxstyle='round',\n","                         facecolor='white',\n","                         alpha=0.8,\n","                         edgecolor='gray',\n","                         linewidth=1))\n","\n","    # Добавляем заголовок\n","    ax.set_title('Диаграмма оценки потенциала здания',\n","                 fontsize=16, fontweight='bold', pad=20)\n","\n","    # Добавляем легенду с цветовой кодировкой\n","    legend_labels = [\n","        'Низкий (0-0.19)',\n","        'Ограниченный (0.2-0.49)',\n","        'Оптимальный (0.5-0.79)',\n","        'Высокий (0.8-1)'\n","    ]\n","    legend_colors = ['#FF6B6B', '#FFD166', '#4ECDC4', '#06D6A0']\n","\n","    # Создаем патчи для легенды\n","    from matplotlib.patches import Patch\n","    legend_elements = [Patch(facecolor=color, label=label)\n","                       for color, label in zip(legend_colors, legend_labels)]\n","\n","    ax.legend(handles=legend_elements,\n","              loc='center left',\n","              bbox_to_anchor=(1, 0.5),\n","              fontsize=11,\n","              title='Уровень потенциала',\n","              title_fontsize=12)\n","\n","    # Устанавливаем соотношение сторон, чтобы круг был кругом\n","    ax.axis('equal')\n","\n","    # Добавляем подпись с итоговой информацией\n","    total_score = np.mean(values) * 4  # Среднее * 4 для масштаба 0-4\n","    plt.figtext(0.5, 0.01,\n","                f'Общий балл I = {total_score:.2f} (из 4.0)',\n","                ha='center',\n","                fontsize=12,\n","                fontweight='bold',\n","                bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","    # Выводим текстовую интерпретацию\n","    print(\"\\n\" + \"=\"*60)\n","    print(\"ИНТЕРПРЕТАЦИЯ РЕЗУЛЬТАТОВ:\")\n","    print(\"=\"*60)\n","\n","    category_names = ['i₁ (архитектурно-планировочные)',\n","                     'i₂ (социально-экономические)',\n","                     'i₃ (инженерно-технические)',\n","                     'i₄ (историко-культурные)']\n","\n","    for i, (val, cat) in enumerate(zip(values, category_names), 1):\n","        if 0 <= val < 0.2:\n","            level = \"Низкий\"\n","        elif 0.2 <= val < 0.5:\n","            level = \"Ограниченный\"\n","        elif 0.5 <= val < 0.8:\n","            level = \"Оптимальный\"\n","        else:\n","            level = \"Высокий\"\n","\n","        print(f\"{cat}: {val:.2f} → {level} уровень потенциала\")\n","\n","    print(\"\\nОбщий балл I = {:.2f}/4.0\".format(total_score))\n","\n","\n","\n","# Функция для интерактивного ввода\n","def interactive_chart():\n","    \"\"\"Функция для интерактивного ввода значений\"\"\"\n","    print(\"\\n\" + \"=\"*60)\n","    print(\"ИНТЕРАКТИВНЫЙ ВВОД ДАННЫХ\")\n","    print(\"=\"*60)\n","\n","    try:\n","        i_1 = float(input(\"Введите значение i₁ (архитектурно-планировочные, 0-1): \"))\n","        i_2 = float(input(\"Введите значение i₂ (социально-экономические, 0-1): \"))\n","        i_3 = float(input(\"Введите значение i₃ (инженерно-технические, 0-1): \"))\n","        i_4 = float(input(\"Введите значение i₄ (историко-культурные, 0-1): \"))\n","\n","        print(\"\\n\" + \"=\"*60)\n","        print(\"ГЕНЕРАЦИЯ ДИАГРАММЫ...\")\n","        print(\"=\"*60)\n","\n","        create_potential_chart(i_1, i_2, i_3, i_4)\n","\n","    except ValueError:\n","        print(\"Ошибка: пожалуйста, вводите только числа!\")\n","    except Exception as e:\n","        print(f\"Произошла ошибка: {e}\")"],"metadata":{"id":"1qio_IM-BDkE"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["create_potential_chart(i_1, i_2, i_3, i_4)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":628},"id":"FI0BT6DeBF5m","executionInfo":{"status":"ok","timestamp":1768058205257,"user_tz":-180,"elapsed":865,"user":{"displayName":"Ольга Крысанова","userId":"12760075569232653329"}},"outputId":"e2864090-ef9e-4fb9-bda8-c4fb1c2f1c8f"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","============================================================\n","ИНТЕРПРЕТАЦИЯ РЕЗУЛЬТАТОВ:\n","============================================================\n","i₁ (архитектурно-планировочные): 0.67 → Оптимальный уровень потенциала\n","i₂ (социально-экономические): 0.89 → Высокий уровень потенциала\n","i₃ (инженерно-технические): 1.00 → Высокий уровень потенциала\n","i₄ (историко-культурные): 0.82 → Высокий уровень потенциала\n","\n","Общий балл I = 3.38/4.0\n"]}]}]}